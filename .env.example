ANTHROPIC_API_KEY=

# Main model (triage router + response agent)
MODEL=claude-opus-5-5
# Model for LangMem internals (prompt optimizer, fact consolidation).
# Must accept forced tool_choice -> not Opus 5.5 / Sonnet 5.5 / Fable 5.1.
MEMORY_MODEL=claude-haiku-4-5
# DISABLE_FALLBACKS=1    # turn off server-side refusal fallbacks

# Local fastembed model (default) or "provider:model", e.g. openai:text-embedding-3-small
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Postgres + pgvector for persistent memory (uv sync --extra postgres). Empty = in-memory.
DATABASE_URL=
USER_ID=alex

# mock | google (uv sync --extra google)
TOOLS_BACKEND=mock
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json
TIMEZONE=Europe/Prague

# 1 = run background fact consolidation after each email in `run`
CONSOLIDATE_FACTS=0

# Web UI / Gmail push (uv run email-assistant serve)
# GMAIL_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# PUBSUB_VERIFICATION_TOKEN=<random string, also put in the push subscription URL ?token=...>
